{
  "name": "@humangated/livegate",
  "version": "1.0.0",
  "description": "The dormant review overlay for a running app. Wakes for one named reviewer, one open ask, a couple of hours — and only because they arrived holding a grant.",
  "license": "MIT",
  "author": "Brightwing Systems, LLC",
  "homepage": "https://humangated.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brightwing-Systems-LLC/humangated-livegate.git"
  },
  "bugs": "https://github.com/Brightwing-Systems-LLC/humangated-livegate/issues",
  "keywords": ["review", "annotation", "feedback", "overlay", "humangated"],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/livegate.mjs",
  "module": "./dist/livegate.mjs",
  "exports": {
    ".": {
      "import": "./dist/livegate.mjs",
      "default": "./dist/livegate.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import ./test/helpers/register.mjs --test test/*.test.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0"
  }
}
